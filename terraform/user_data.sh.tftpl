#!/bin/bash
set -euxo pipefail

dnf install -y docker git
systemctl enable --now docker

git clone --depth 1 --branch "${repo_ref}" "${repo_url}" /opt/wq
cd /opt/wq
docker build -t water-quality-monitor:deployed .

docker run -d --name wq --restart unless-stopped \
  -p 80:${app_port} \
  --read-only --tmpfs /tmp \
  --cap-drop ALL --security-opt no-new-privileges \
  water-quality-monitor:deployed
